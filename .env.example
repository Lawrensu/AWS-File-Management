# Copy to .env. Never commit .env.
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
# Bedrock model IDs. Check model access in the Bedrock console for AWS_REGION first.
# If a model is only available via a cross-region inference profile, use that ID instead.
# Titan v2 is not offered in ap-southeast-1. Cohere Multilingual v3 is, with the same 1024 dims.
BEDROCK_EMBED_MODEL=cohere.embed-multilingual-v3
BEDROCK_TAG_MODEL=anthropic.claude-haiku-4-5
BEDROCK_ANSWER_MODEL=anthropic.claude-sonnet-5-5
# Groq fallback for tagging and answers when Bedrock fails. Free tier, no card.
# Get a key at console.groq.com. Leave empty to disable the fallback.
# Embeddings have no fallback: search drops to BM25 only.
GROQ_API_KEY=
GROQ_TAG_MODEL=llama-3.1-8b-instant
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile
# Optional S3 bucket for uploads. Leave empty to keep files in data/uploads/.
S3_BUCKET=
INDEX_PATH=data/index.sqlite
NEXT_PUBLIC_API_URL=http://localhost:8000
