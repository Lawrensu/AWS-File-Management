{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chunk.schema.json",
  "title": "Chunk",
  "type": "object",
  "required": ["chunk_id", "doc_id", "page", "text", "lang", "source"],
  "additionalProperties": false,
  "properties": {
    "chunk_id": { "type": "string", "pattern": "^[0-9a-f]{16}:[0-9]+:[0-9]+$" },
    "doc_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "page": { "type": "integer", "minimum": 1, "description": "1-indexed. Mandatory. Citations depend on it." },
    "bbox": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x0, y0, x1, y1] in PDF points of the first text block in the chunk. Null if unknown."
    },
    "heading": { "type": ["string", "null"], "description": "Nearest heading above the chunk, if detected." },
    "text": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "enum": ["ms", "en", "mixed"] },
    "source": { "type": "string", "enum": ["native", "textract", "vision"] },
    "embedding": {
      "type": ["array", "null"],
      "items": { "type": "number" },
      "description": "1024 floats from Cohere Embed Multilingual v3. Stored, never returned by the API."
    }
  }
}
